{
  "name": "aurora-player",
  "productName": "Aurora Player",
  "version": "1.0.0",
  "description": "Media player with audio-reactive visualizations in the style of the classic Windows Media Player",
  "author": "davvoz",
  "homepage": "https://github.com/davvoz/sound_player_music_visualizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/davvoz/sound_player_music_visualizer.git"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win nsis --publish never",
    "release": "node scripts/make-icon.js && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.aurora.player",
    "productName": "Aurora Player",
    "files": [
      "main.js",
      "preload.js",
      "assoc.js",
      "formats.js",
      "updater.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "Aurora-Player-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davvoz",
        "repo": "sound_player_music_visualizer",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "music-metadata": "^7.14.0"
  }
}
